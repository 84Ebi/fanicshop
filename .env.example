# ── fanic_bot environment template ──────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored.
# Secrets are read ONLY from the environment / .env.

# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather
BOT_TOKEN=
# polling | webhook (default polling, no TLS needed for MVP)
BOT_MODE=polling
# Only used when BOT_MODE=webhook
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs allowed as administrators.
ADMIN_IDS=
# Role map: "tgid:owner,tgid:support". Ids in ADMIN_IDS default to owner.
# 'support' cannot touch money/broadcast/settings.
ADMIN_ROLES=
# Chat id of the admin notification group (signups, paid orders, alerts).
ADMIN_GROUP_CHAT_ID=

# ── Infrastructure ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fanic:fanic@postgres:5432/fanic
# Optional overrides for the postgres container (defaults match DATABASE_URL above)
POSTGRES_USER=fanic
POSTGRES_PASSWORD=fanic
POSTGRES_DB=fanic
REDIS_URL=redis://redis:6379/0

# ── Receiving card (card-to-card payment) ────────────────────────────────────
# Full PAN is env-only and NEVER stored in the DB or logs.
SHOP_CARD_NUMBER=
SHOP_CARD_HOLDER=
SHOP_BANK_CODE=

# ── SMS ingestion ────────────────────────────────────────────────────────────
# HMAC signing secret for the internal SMS webhook (shared with the phone side)
SMS_HMAC_SECRET=
# Comma-separated device ids allowed to call the SMS endpoint.
SMS_DEVICE_IDS=
# true = keep raw SMS bodies (masked on insert); false = discard after parse.
STORE_RAW_SMS=false

# ── Payment policies ────────────────────────────────────────────────────────
PAYMENT_WINDOW_MINUTES=15
SUFFIX_MIN_TOMAN=1
SUFFIX_MAX_TOMAN=999
SMS_GRACE_MINUTES=120

# ── Runtime ──────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
TZ=Asia/Tehran
LOG_LEVEL=INFO
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
